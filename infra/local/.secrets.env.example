# Copy to infra/local/.secrets.env (gitignored) to send real telemetry from the local environment.
# Without it the Terraform placeholders stay: RUM off, Coralogix export rejected, captioning off.
# Every key below belongs to the same Coralogix team. Its region, as the bare domain (eu1.coralogix.com,
# eu2.coralogix.com, us1.coralogix.com, us2.coralogix.com, ap1.coralogix.com, ...): the one region setting.
CX_DOMAIN=eu1.coralogix.com
CORALOGIX_PRIVATE_KEY=
CORALOGIX_RUM_PUBLIC_KEY=
LLM_API_KEY=
# Send-Your-Data key with the OpsEvents role preset: Coralogix annotations from Argo CD and Terraform (ADR-025).
CX_OPS_EVENTS_API_KEY=
# API key with the Alerts, Dashboards and Notification Center permissions: the observability stack (ADR-024).
CORALOGIX_API_KEY=
