                "definition": {
                  "dataTable": {
                    "query": {
                      "dataprime": {
                        "dataprimeQuery": {
                          "text": "source logs | filter $l.subsystemname == 'cx_rum' && $d.cx_rum.event_context.type == 'web-vitals' | groupby $d.cx_rum.version_metadata.app_version as version aggregate percentile(0.75, if($d.cx_rum.web_vitals_context.name=='LCP', $d.cx_rum.web_vitals_context.value)) as lcp_p75, percentile(0.75, if($d.cx_rum.web_vitals_context.name=='INP', $d.cx_rum.web_vitals_context.value)) as inp_p75, percentile(0.75, if($d.cx_rum.web_vitals_context.name=='CLS', $d.cx_rum.web_vitals_context.value)) as cls_p75 | orderby version desc"
                        },
                        "filters": []
                      }
                    },
                    "resultsPerPage": 20,
                    "rowStyle": "ROW_STYLE_ONE_LINE",
                    "columns": [
                      {
                        "field": "$d.version"
                      },
                      {
                        "field": "$d.lcp_p75"
                      },
                      {
                        "field": "$d.inp_p75"
                      },
                      {
                        "field": "$d.cls_p75"
                      }
                    ],
