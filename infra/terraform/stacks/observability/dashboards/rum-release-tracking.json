                        "decimal": 2,
                        "hashColors": false,
                        "decimalPrecision": false,
                        "intervalResolution": {
                          "auto": {
                            "minimumInterval": "60s",
                            "maximumDataPoints": 96
                          }
                        }
                      }
                    ],
                    "stackedLine": "STACKED_LINE_UNSPECIFIED",
                    "connectNulls": false
                  }
                },
                "highlighted": false
              }
