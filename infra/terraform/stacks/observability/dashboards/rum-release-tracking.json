                },
                "title": "Adoption graph — sessions per version over time",
                "definition": {
                  "lineChart": {
                    "legend": {
                      "isVisible": true,
                      "columns": [],
                      "groupByQuery": true,
                      "placement": "LEGEND_PLACEMENT_AUTO"
                    },
                    "tooltip": {
                      "showLabels": false,
                      "type": "TOOLTIP_TYPE_ALL"
                    },
                    "queryDefinitions": [
                      {
                        "id": "05b2aebd-849d-4885-9341-dbe8cd7b6105",
                        "query": {
                          "dataprime": {
                            "dataprimeQuery": {
                              "text": "source logs | filter $l.subsystemname == 'cx_rum' | groupby roundTime($m.timestamp, 1h) as t, $d.cx_rum.version_metadata.app_version as version aggregate approx_count_distinct($d.cx_rum.session_context.session_id) as sessions | orderby t asc"
                            },
                            "filters": []
                          }
                        },
                        "seriesCountLimit": "20",
                        "unit": "UNIT_UNSPECIFIED",
                        "scaleType": "SCALE_TYPE_LINEAR",
                        "isVisible": true,
                        "colorScheme": "classic",
