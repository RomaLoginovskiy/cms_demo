                "highlighted": false
              },
              {
                "id": {
                  "value": "5f9d514c-bf38-4b71-96c2-1e98143193c7"
                },
                "title": "Crash-free sessions % per release",
                "definition": {
                  "dataTable": {
                    "query": {
                      "dataprime": {
                        "dataprimeQuery": {
                          "text": "source logs | filter $l.subsystemname == 'cx_rum' | groupby $d.cx_rum.version_metadata.app_version as version aggregate 100.0 * (approx_count_distinct($d.cx_rum.session_context.session_id) - approx_count_distinct(if($d.cx_rum.event_context.severity:num==5, $d.cx_rum.session_context.session_id))) / approx_count_distinct($d.cx_rum.session_context.session_id) as crash_free_pct | orderby version desc"
                        },
                        "filters": []
                      }
                    },
                    "resultsPerPage": 20,
                    "rowStyle": "ROW_STYLE_ONE_LINE",
                    "columns": [
                      {
                        "field": "$d.version"
                      },
                      {
                        "field": "$d.crash_free_pct"
                      }
                    ],
                    "dataModeType": "DATA_MODE_TYPE_ARCHIVE"
                  }
                },
                "highlighted": false
              }
            ]
          }
