                "definition": {
                  "dataTable": {
                    "query": {
                      "dataprime": {
                        "dataprimeQuery": {
                          "text": "source logs | filter $l.subsystemname == 'cx_rum' | groupby $d.cx_rum.version_metadata.app_version as version aggregate approx_count_distinct(if($d.cx_rum.event_context.severity:num==5, $d.cx_rum.session_context.user_id)) as affected_users, approx_count_distinct($d.cx_rum.session_context.user_id) as total_users | orderby affected_users desc"
                        },
                        "filters": []
                      }
                    },
                    "resultsPerPage": 20,
                    "rowStyle": "ROW_STYLE_ONE_LINE",
                    "columns": [
                      {
                        "field": "$d.version"
                      },
                      {
