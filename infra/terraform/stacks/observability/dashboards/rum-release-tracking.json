            },
            "widgets": [
              {
                "id": {
                  "value": "8c4c1e21-364f-4c11-b935-3c5ae614896a"
                },
                "title": "New errors per release (first-seen version)",
                "definition": {
                  "dataTable": {
                    "query": {
                      "dataprime": {
                        "dataprimeQuery": {
                          "text": "source logs | filter $l.subsystemname == 'cx_rum' && $d.cx_rum.event_context.type == 'error' | groupby $d.cx_rum.fingerPrint as fp aggregate min_by($m.timestamp, $d.cx_rum.version_metadata.app_version) as first_version | groupby first_version aggregate count() as new_error_fingerprints | orderby new_error_fingerprints desc"
                        },
                        "filters": []
                      }
                    },
                    "resultsPerPage": 20,
                    "rowStyle": "ROW_STYLE_ONE_LINE",
                    "columns": [
                      {
                        "field": "$d.first_version"
                      },
                      {
                        "field": "$d.new_error_fingerprints"
                      }
                    ],
                    "dataModeType": "DATA_MODE_TYPE_ARCHIVE"
                  }
                },
                "highlighted": false
              },
              {
                "id": {
                  "value": "e8a38841-fd62-45ba-950a-03db1d4ac6f6"
                },
                "title": "Side-by-side compare (sessions · errors · LCP p75)",
                "definition": {
                  "dataTable": {
                    "query": {
                      "dataprime": {
                        "dataprimeQuery": {
                          "text": "source logs | filter $l.subsystemname == 'cx_rum' | groupby $d.cx_rum.version_metadata.app_version as version aggregate approx_count_distinct($d.cx_rum.session_context.session_id) as sessions, count_if($d.cx_rum.event_context.severity:num==5) as errors, percentile(0.75, if($d.cx_rum.web_vitals_context.name=='LCP', $d.cx_rum.web_vitals_context.value)) as lcp_p75 | orderby version desc"
                        },
                        "filters": []
                      }
                    },
                    "resultsPerPage": 20,
                    "rowStyle": "ROW_STYLE_ONE_LINE",
                    "columns": [
                      {
                        "field": "$d.version"
                      },
                      {
                        "field": "$d.sessions"
                      },
                      {
                        "field": "$d.errors"
                      },
                      {
                        "field": "$d.lcp_p75"
                      }
                    ],
                    "dataModeType": "DATA_MODE_TYPE_ARCHIVE"
                  }
                },
                "highlighted": false
              }
            ]
          }
        ],
        "options": {
          "custom": {
            "name": "Errors per release",
            "collapsed": false,
            "color": {
              "predefined": "SECTION_PREDEFINED_COLOR_UNSPECIFIED"
            }
          }
