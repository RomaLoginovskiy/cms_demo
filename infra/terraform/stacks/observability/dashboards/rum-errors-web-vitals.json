            "widgets": [
              {
                "id": {
                  "value": "8a64b821-d494-42d2-b0d1-88d2731534b8"
                },
                "title": "% sessions with error over time",
                "definition": {
                  "lineChart": {
                    "legend": {
                      "isVisible": true,
                      "columns": [],
                      "groupByQuery": true,
                      "placement": "LEGEND_PLACEMENT_AUTO"
                    },
                    "tooltip": {
                      "showLabels": false,
                      "type": "TOOLTIP_TYPE_ALL"
                    },
                    "queryDefinitions": [
                      {
                        "id": "2d8c42aa-e1cc-4896-8425-10736eaf41b2",
                        "query": {
                          "dataprime": {
                            "dataprimeQuery": {
                              "text": "source logs | filter $l.subsystemname == 'cx_rum' | groupby roundTime($m.timestamp, 1h) as t aggregate approx_count_distinct(if($d.cx_rum.event_context.severity:num == 5, $d.cx_rum.session_context.session_id)) * 100.0 / approx_count_distinct($d.cx_rum.session_context.session_id) as pct_current | orderby t asc"
                            },
                            "filters": []
                          }
                        },
                        "seriesCountLimit": "20",
                        "unit": "UNIT_PERCENT",
                        "scaleType": "SCALE_TYPE_LINEAR",
                        "isVisible": true,
                        "colorScheme": "classic",
                        "dataModeType": "DATA_MODE_TYPE_ARCHIVE",
                        "decimal": 2,
                        "hashColors": false,
                        "decimalPrecision": false
                      }
                    ],
                    "stackedLine": "STACKED_LINE_UNSPECIFIED",
                    "connectNulls": false,
                    "xAxisTimeFormat": "X_AXIS_TIME_FORMAT_AUTO"
                  }
                },
                "highlighted": false
              },
              {
                "id": {
                  "value": "70d179a8-6988-41c2-b404-f81a12064456"
                },
                "title": "Board-load failure rate",
                "definition": {
                  "gauge": {
                    "query": {
                      "dataprime": {
                        "dataprimeQuery": {
                          "text": "source logs | filter $l.subsystemname == 'cx_rum' && $d.cx_rum.event_context.type == 'custom-measurement' | aggregate count_if($d.cx_rum.custom_measurement_context.name == 'whiteboard_hub_error') * 100.0 / count_if($d.cx_rum.custom_measurement_context.name == 'whiteboard_hub_error' || $d.cx_rum.custom_measurement_context.name == 'whiteboard_hub_joined') as board_load_failure_rate"
                        },
                        "filters": []
                      }
                    },
                    "min": 0,
                    "max": 100,
                    "showInnerArc": true,
                    "showOuterArc": true,
                    "unit": "UNIT_PERCENT",
                    "thresholds": [
                      {
                        "from": 0,
                        "color": "var(--c-visualization-green-05)"
                      },
                      {
                        "from": 10,
                        "color": "var(--c-visualization-yellow-05)"
                      },
                      {
                        "from": 30,
                        "color": "var(--c-visualization-red-05)"
                      }
                    ],
                    "dataModeType": "DATA_MODE_TYPE_ARCHIVE",
                    "thresholdBy": "THRESHOLD_BY_UNSPECIFIED",
                    "decimal": 1,
                    "thresholdType": "THRESHOLD_TYPE_ABSOLUTE",
                    "legend": {
                      "isVisible": false,
                      "columns": [],
                      "groupByQuery": true,
                      "placement": "LEGEND_PLACEMENT_AUTO"
                    },
                    "legendBy": "LEGEND_BY_GROUPS",
                    "displaySeriesName": false,
                    "decimalPrecision": false
                  }
                },
                "highlighted": false
              }
            ]
          }
