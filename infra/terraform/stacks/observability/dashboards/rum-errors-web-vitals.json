                "title": "Error volume per critical flow",
                "definition": {
                  "dataTable": {
                    "query": {
                      "dataprime": {
                        "dataprimeQuery": {
                          "text": "source logs | filter $l.subsystemname == 'cx_rum' && $d.cx_rum.event_context.severity:num == 5 | groupby $d.cx_rum.labels.integrationContext as flow aggregate count() as errors | orderby errors desc"
                        },
                        "filters": []
                      }
                    },
                    "resultsPerPage": 20,
                    "rowStyle": "ROW_STYLE_ONE_LINE",
                    "columns": [
