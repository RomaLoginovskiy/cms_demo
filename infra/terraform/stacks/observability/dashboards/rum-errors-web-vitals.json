              {
                "id": {
                  "value": "c4b3f387-eb9e-4f4a-9ee1-0193ec77f7da"
                },
                "title": "Top error fingerprints (first/last seen)",
                "definition": {
                  "dataTable": {
                    "query": {
                      "dataprime": {
                        "dataprimeQuery": {
                          "text": "source logs | filter $l.subsystemname == 'cx_rum' && $d.cx_rum.event_context.type == 'error' | groupby $d.cx_rum.fingerPrint as fingerprint aggregate count() as errors, min($m.timestamp.formatTimestamp('iso8601bare')) as first_seen, max($m.timestamp.formatTimestamp('iso8601bare')) as last_seen, any_value($d.cx_rum.error_context.error_message) as message, any_value($d.cx_rum.error_context.error_type) as type | orderby errors desc | limit 20"
                        },
                        "filters": []
                      }
                    },
                    "resultsPerPage": 20,
                    "rowStyle": "ROW_STYLE_ONE_LINE",
                    "columns": [
                      {
                        "field": "$d.fingerprint"
                      },
                      {
                        "field": "$d.errors"
                      },
                      {
                        "field": "$d.first_seen"
                      },
                      {
                        "field": "$d.last_seen"
                      },
                      {
                        "field": "$d.message"
                      },
                      {
                        "field": "$d.type"
                      }
                    ],
                    "dataModeType": "DATA_MODE_TYPE_ARCHIVE"
                  }
                },
                "highlighted": false
              }
            ]
          }
        ],
